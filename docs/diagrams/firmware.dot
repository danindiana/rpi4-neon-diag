digraph G {
    bgcolor="#0D0D0D";
    node [style=filled, fillcolor="#1A1A1A", fontcolor="#00FFFF", color="#FF00FF", fontname="Monospace"];
    edge [color="#00FFFF", fontname="Monospace"];
    label="POWER & FIRMWARE PULSE";
    labelloc="t"; fontcolor="#FF00FF"; fontname="Monospace";
    
    node [shape=Mrecord, color="#00FFFF"];
    power [label="Throttle State\n0x0"];
    volts [label="Core Voltage\n1.0100V"];
    clock [label="Arm Clock\n2000.48 MHz"];
    pi_firm [label="VCGENCMD", shape=doublecircle, color="#FFFF33"];
    pi_firm -> power; pi_firm -> volts; pi_firm -> clock;

}
